# Django: секретний ключ, режим налагодження та дозволені хости.
DJANGO_SECRET_KEY=local-dev-only-change-before-deployment
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL: база, користувач і пароль для локального запуску.
POSTGRES_DB=devops
POSTGRES_USER=devops
POSTGRES_PASSWORD=local-dev-password

# Порт Nginx на комп'ютері (80 — http://localhost).
HTTP_PORT=80
