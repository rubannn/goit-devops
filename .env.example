# Налаштування install_dev_tools.sh.
# Скрипт не читає .env автоматично. Для завантаження змінних у Bash:
# cp .env.example .env
# set -a
# source .env
# set +a
# ./install_dev_tools.sh

# DEV_TOOLS_VENV — шлях до віртуального середовища для Django.
# Необов'язкова змінна. Порожнє значення означає .venv поруч зі скриптом.
# Відносний шлях рахується від каталогу, з якого запускається скрипт.
# Приклад абсолютного шляху: DEV_TOOLS_VENV="/home/user/dev-tools/.venv"
# Якщо Django вже доступний у системному Python, середовище не створюється.
DEV_TOOLS_VENV=

# ID і VERSION_CODENAME скрипт отримує з /etc/os-release.
# EUID і BASH_SOURCE надає Bash; задавати їх у .env не потрібно.
